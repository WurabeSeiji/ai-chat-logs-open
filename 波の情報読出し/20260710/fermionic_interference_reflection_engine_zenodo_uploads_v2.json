    "conceptdoi": "10.5281/zenodo.21295479",
    "metadata": {
      "title": "Interference Construction of a Perfect Reflection Map from a Fermionic Inverse-Phase Core",
      "publication_date": "2026-07-13",
      "description": "This release publishes an additional constructive experiment in which the direct direction-reversal rule used in a previous AB/C complete elastic-reflection simulation is replaced by a local exchange-interference map controlled by the internal phase of a fermionic inverse-phase core. The release includes Japanese and English manuscripts, TeX/PDF builds, the executed numerical script, result JSON/CSV files, figures, and a reproducibility bundle.",
      "access_right": "open",
      "creators": [
        {
          "name": "Kihara, Noriaki",
          "affiliation": "WF System Co., Ltd.",
          "orcid": "0009-0004-6753-4020"
        }
      ],
      "keywords": [
        "fermionic inverse-phase core",
        "exchange interference",
        "local exchange-interference map",
        "complete elastic reflection",
        "closed phase system",
        "internal observation",
        "numerical constructive experiment"
      ],
      "related_identifiers": [
        {
          "identifier": "10.5281/zenodo.21291018",
          "relation": "isSupplementTo",
          "resource_type": "publication-preprint",
          "scheme": "doi"
        }
      ],
      "version": "v2",
      "language": "eng",
      "license": "cc-by-4.0",
      "imprint_publisher": "Zenodo",
      "notes": "The direction reversal in the preceding finite-resolution AB/C collision model is not inserted as q -&gt; -q in this release. It is generated from the readout of a local exchange-interference map, q_out = q_in * (T - R), where R and T are obtained from the final waveform.",
      "upload_type": "publication",
      "publication_type": "preprint",
      "prereserve_doi": {
