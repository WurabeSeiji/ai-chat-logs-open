    "metadata": {
      "title": "Curvature Renormalization and Perfect-Reflection Stability by Curved Closed Stationary Waves",
      "publication_date": "2026-07-13",
      "description": "This release publishes a numerical constructive experiment on how odd-harmonic complex waves satisfying the all-positive zero closure Sigma x_n^2 = 0 are stabilized inside curved local cells. Curvature-induced relative phase leakage is shown to produce closure residuals and transmission leakage in transient states, while internal phase re-selection into closed stationary waves absorbs the leakage and recovers the complete-reflection readout of the preceding local exchange-interference map. The release includes Japanese and English manuscripts, TeX/PDF builds, executed numerical scripts, result JSON/CSV files, figures, and a reproducibility bundle.",
      "access_right": "open",
      "creators": [
        {
          "name": "Kihara, Noriaki",
          "affiliation": "WF System Co., Ltd.",
          "orcid": "0009-0004-6753-4020"
        }
      ],
      "keywords": [
        "all-positive zero closure",
        "curved closed stationary wave",
        "curvature renormalization",
        "odd harmonics",
        "exchange interference",
        "complete reflection",
        "local constant-curvature cell",
        "internal phase re-selection",
        "numerical constructive experiment"
      ],
      "related_identifiers": [
        {
          "identifier": "10.5281/zenodo.20680269",
          "relation": "isSupplementTo",
          "resource_type": "publication-preprint",
          "scheme": "doi"
        },
        {
          "identifier": "10.5281/zenodo.21295479",
          "relation": "isSupplementTo",
          "resource_type": "publication-preprint",
          "scheme": "doi"
        }
      ],
      "version": "v2",
      "language": "eng",
      "license": "cc-by-4.0",
      "imprint_publisher": "Zenodo",
      "notes": "This paper does not claim a quantitative prediction of real spacetime curvature. Curvature is modeled as local relative phase leakage. The tested result is that the all-positive zero closure detects such leakage and that internal phase re-selection into closed stationary waves restores the exchange-interference complete-reflection readout.",
