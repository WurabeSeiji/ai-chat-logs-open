{"created": "2026-07-18T00:39:59.333400+00:00", "modified": "2026-07-18T00:40:01.343214+00:00", "id": 21421367, "conceptrecid": "21421366", "doi": "10.5281/zenodo.21421367", "conceptdoi": "10.5281/zenodo.21421366", "doi_url": "https://doi.org/10.5281/zenodo.21421367", "metadata": {"title": "Discovery of Finite-Order Resonance in Iterated Exchange Scattering: Identifying Sharp Peaks near Fine-Structure-Constant Inverse Values 137 and 128 with a Reproducible Wave-Packet Model", "doi": "10.5281/zenodo.21421367", "publication_date": "2026-07-18", "description": "This preprint investigates sharp parameter-space peaks previously observed near values corresponding to inverse fine-structure constants 137 and 128 in two exchange-scattering wave-packet simulations. Full-range reanalysis, root-centered sweeps, eigenvalue analysis, and 50- and 80-digit calculations show that the peaks arise from exact finite-order recurrence of the antisymmetric eigenvalue of a two-channel unitary exchange operator. The roots are R_(n,m) = cos^2(pi m/n); the principal low-energy peak is R_(124,23), the former high-energy candidate is R_(122,23), and R_(620,117) lies within 0.1243 standard deviations of alpha^(-1)(M_Z^2) = 128.946 +/- 0.015 under the study's readout correspondence. Ideal even-order roots have zero gray error and hence formally infinite depth, denoting zero residual rather than divergent energy. The main contribution is a reproducible numerical model connecting exact operator recurrence to wave-packet localization transfer and metastable two-state readout. The study does not derive alpha: whether the proximity to the two physical alpha^(-1) values is an arithmetic coincidence or reflects an additional structural necessity remains open.", "access_right": "open", "creators": [{"name": "Kihara, Noriaki", "affiliation": "WF System Co., Ltd.", "orcid": "0009-0004-6753-4020"}], "keywords": ["finite-order resonance", "exchange scattering", "quantum recurrence", "Floquet operator", "fine-structure constant", "wave-packet localization", "metastable two-state readout", "reproducible numerical model"], "related_identifiers": [{"identifier": "10.5281/zenodo.21333766", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21353208", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21396760", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}], "version": "v1.0", "language": "eng", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21421366"}}]}}, "title": "Discovery of Finite-Order Resonance in Iterated Exchange Scattering: Identifying Sharp Peaks near Fine-Structure-Constant Inverse Values 137 and 128 with a Reproducible Wave-Packet Model", "links": {"self": "https://zenodo.org/api/records/21421367", "self_html": "https://zenodo.org/records/21421367", "preview_html": "https://zenodo.org/records/21421367?preview=1", "doi": "https://doi.org/10.5281/zenodo.21421367", "self_doi": "https://doi.org/10.5281/zenodo.21421367", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21421367", "reserve_doi": "https://zenodo.org/api/records/21421367/draft/pids/doi", "parent": "https://zenodo.org/api/records/21421366", "parent_html": "https://zenodo.org/records/21421366", "parent_doi": "https://doi.org/10.5281/zenodo.21421366", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21421366", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21421367/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21421367/sequence/default", "files": "https://zenodo.org/api/records/21421367/files", "media_files": "https://zenodo.org/api/records/21421367/media-files", "thumbnails": {"10": "https://zenodo.org/api/i