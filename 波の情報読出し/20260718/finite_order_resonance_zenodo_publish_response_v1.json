{"created": "2026-07-18T00:39:59.333400+00:00", "modified": "2026-07-18T00:40:01.343214+00:00", "id": 21421367, "conceptrecid": "21421366", "doi": "10.5281/zenodo.21421367", "conceptdoi": "10.5281/zenodo.21421366", "doi_url": "https://doi.org/10.5281/zenodo.21421367", "metadata": {"title": "Discovery of Finite-Order Resonance in Iterated Exchange Scattering: Identifying Sharp Peaks near Fine-Structure-Constant Inverse Values 137 and 128 with a Reproducible Wave-Packet Model", "doi": "10.5281/zenodo.21421367", "publication_date": "2026-07-18", "description": "This preprint investigates sharp parameter-space peaks previously observed near values corresponding to inverse fine-structure constants 137 and 128 in two exchange-scattering wave-packet simulations. Full-range reanalysis, root-centered sweeps, eigenvalue analysis, and 50- and 80-digit calculations show that the peaks arise from exact finite-order recurrence of the antisymmetric eigenvalue of a two-channel unitary exchange operator. The roots are R_(n,m) = cos^2(pi m/n); the principal low-energy peak is R_(124,23), the former high-energy candidate is R_(122,23), and R_(620,117) lies within 0.1243 standard deviations of alpha^(-1)(M_Z^2) = 128.946 +/- 0.015 under the study's readout correspondence. Ideal even-order roots have zero gray error and hence formally infinite depth, denoting zero residual rather than divergent energy. The main contribution is a reproducible numerical model connecting exact operator recurrence to wave-packet localization transfer and metastable two-state readout. The study does not derive alpha: whether the proximity to the two physical alpha^(-1) values is an arithmetic coincidence or reflects an additional structural necessity remains open.", "access_right": "open", "creators": [{"name": "Kihara, Noriaki", "affiliation": "WF System Co., Ltd.", "orcid": "0009-0004-6753-4020"}], "keywords": ["finite-order resonance", "exchange scattering", "quantum recurrence", "Floquet operator", "fine-structure constant", "wave-packet localization", "metastable two-state readout", "reproducible numerical model"], "related_identifiers": [{"identifier": "10.5281/zenodo.21333766", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21353208", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21396760", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}], "version": "v1.0", "language": "eng", "license": "cc-by-4.0", "imprint_publisher": "Zenodo", "upload_type": "publication", "publication_type": "preprint", "prereserve_doi": {"doi": "10.5281/zenodo.21421367", "recid": 21421367}}, "title": "Discovery of Finite-Order Resonance in Iterated Exchange Scattering: Identifying Sharp Peaks near Fine-Structure-Constant Inverse Values 137 and 128 with a Reproducible Wave-Packet Model", "links": {"self": "https://zenodo.org/api/records/21421367", "html": "https://zenodo.org/records/21421367", "doi": "https://doi.org/10.5281/zenodo.21421367", "parent_doi": "https://doi.org/10.5281/zenodo.21421366", "badge": "https://zenodo.org/badge/doi/10.5281%2Fzenodo.21421367.svg", "conceptbadge": "https://zenodo.org/badge/doi/10.5281%2Fzenodo.21421366.svg", "files": "https://zenodo.org/api/records/21421367/files", "bucket": "https://zenodo.org/api/files/76f191af-d562-46dc-b56c-1d3b0323568d", "thumb250": "https://zenodo.org/record/21421367/thumb250", "thumbs": {"10": "https://zenodo.org/record/21421367/thumb10", "50": "https://zenodo.org/record/21421367/thumb50", "100": "https://zenodo.org/record/21421367/thumb100", "250": "https://zenodo.org/record/21421367/thumb250", "750": "https://zenodo.org/record/21421367/thumb750", "1200": "https://zenodo.org/record/21421367/thumb1200"}, "latest_draft": "https://zenodo.org/api/deposit/depositions/21421367", "latest_draft_html": "https://zenodo.org/deposit/21421367", "publish": "ht