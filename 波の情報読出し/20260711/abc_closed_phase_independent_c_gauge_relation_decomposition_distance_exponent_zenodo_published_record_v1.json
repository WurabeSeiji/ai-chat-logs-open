{"created": "2026-07-12T06:46:57.054966+00:00", "modified": "2026-07-12T06:46:57.810153+00:00", "id": 21318701, "conceptrecid": "21318700", "doi": "10.5281/zenodo.21318701", "conceptdoi": "10.5281/zenodo.21318700", "doi_url": "https://doi.org/10.5281/zenodo.21318701", "metadata": {"title": "Preliminary Summary of Distance-Exponent Readout by Independent Metric C and Relational Compensation Decomposition in an ABC Closed Phase System", "doi": "10.5281/zenodo.21318701", "publication_date": "2026-07-12", "description": "This release publishes a preliminary summary of ABC closed phase system experiments designed to test whether adding an internal metric wave C can determine the distance exponent left open by the AB two-body experiments. The experiments introduce C-gauge validity windows, C-position controls, and decomposition of f_AB, f_AC, f_BC, and f_ABC. The results show acceleration-like AB relational compensation, but no native inverse-law or inverse-square-law dependence on position phase difference. Valid cases remained proportional-type, clarifying the boundary of the current one-dimensional localized-wave harmonic model.", "access_right": "open", "creators": [{"name": "Kihara, Noriaki", "affiliation": "WF System Co., Ltd.", "orcid": "0009-0004-6753-4020"}], "keywords": ["ABC closed phase system", "independent metric C", "distance exponent", "relational compensation decomposition", "f_AB", "f_AC", "f_BC", "f_ABC", "inverse-square non-detection", "wave information readout"], "related_identifiers": [{"identifier": "10.5281/zenodo.21315735", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21308049", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21318696", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}], "version": "v1", "language": "eng", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21318700"}}]}, "notes": "This paper does not deny inverse-square laws in general. It rejects only the narrower claim that the present one-dimensional AB harmonic model plus an internal C metric gauge natively produces inverse or inverse-square distance dependence."}, "title": "Preliminary Summary of Distance-Exponent Readout by Independent Metric C and Relational Compensation Decomposition in an ABC Closed Phase System", "links": {"self": "https://zenodo.org/api/records/21318701", "self_html": "https://zenodo.org/records/21318701", "preview_html": "https://zenodo.org/records/21318701?preview=1", "doi": "https://doi.org/10.5281/zenodo.21318701", "self_doi": "https://doi.org/10.5281/zenodo.21318701", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21318701", "reserve_doi": "https://zenodo.org/api/records/21318701/draft/pids/doi", "parent": "https://zenodo.org/api/records/21318700", "parent_html": "https://zenodo.org/records/21318700", "parent_doi": "https://doi.org/10.5281/zenodo.21318700", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21318700", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21318701/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21318701/sequence/default", "files": "https://zenodo.org/api/records/21318701/files", "media_files": "https://zenodo.org/api/records/21318701/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:21318701:abc_closed_phase_independent_c_gauge_relation_decomposition_distance_exponent_preliminary_summary_en.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:21318701:abc_closed_phase_independent_c_gauge_relation_decomposition_distance_exponent_preliminary_summary_en.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:21318701:abc_closed_phas