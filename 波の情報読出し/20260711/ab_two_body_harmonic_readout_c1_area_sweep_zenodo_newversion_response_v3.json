{"created": "2026-07-15T04:18:54.959174+00:00", "modified": "2026-07-15T04:18:55.216431+00:00", "id": 21367800, "conceptrecid": "21318696", "conceptdoi": "10.5281/zenodo.21318696", "metadata": {"title": "Preliminary Summary of Harmonic Readout and c=1 Area Sweep in an AB Two-Body Closed Phase System", "publication_date": "2026-07-15", "description": "This release publishes a preliminary summary of six AB two-body closed phase system experiments. The experiments show that acceleration-like harmonic readout can be constructed from the label-free two-body relation f_AB without introducing external standard forces, individual forces f_A/f_B, or a background space. They also show that the AB two-body system alone lacks an independent gauge for deciding whether the acceleration-like readout follows proportional, inverse, or inverse-square dependence on position phase difference. Internal c=1 calibration and chi-tau area readout can be established, but native inverse-area scaling was not detected.", "access_right": "open", "creators": [{"name": "Kihara, Noriaki", "affiliation": "WF System Co., Ltd.", "orcid": "0009-0004-6753-4020"}], "keywords": ["AB two-body closed phase system", "harmonic readout", "acceleration-like readout", "label-free relation", "c=1 internal calibration", "chi-tau area", "inverse-area diagnosis", "native readout", "wave information readout"], "related_identifiers": [{"identifier": "10.5281/zenodo.21315735", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}, {"identifier": "10.5281/zenodo.21308049", "relation": "isSupplementTo", "resource_type": "publication-preprint", "scheme": "doi"}], "language": "eng", "license": "cc-by-4.0", "imprint_publisher": "Zenodo", "notes": "This paper does not claim a derivation of standard gravity or a native inverse-square law. Its scope is the AB two-body closed phase system: acceleration-like harmonic readout is constructible, while distance-exponent readout remains indeterminate without an independent gauge.", "upload_type": "publication", "publication_type": "preprint", "prereserve_doi": {"doi": "10.5281/zenodo.21367800", "recid": 21367800}}, "title": "Preliminary Summary of Harmonic Readout and c=1 Area Sweep in an AB Two-Body Closed Phase System", "links": {"self": "https://zenodo.org/api/deposit/depositions/21367800", "html": "https://zenodo.org/deposit/21367800", "badge": "https://zenodo.org/badge/doi/.svg", "files": "https://zenodo.org/api/deposit/depositions/21367800/files", "bucket": "https://zenodo.org/api/files/43fe9303-7f27-4985-a5b0-5e96fad9c540", "thumb250": "https://zenodo.org/record/21367800/thumb250", "thumbs": {"10": "https://zenodo.org/record/21367800/thumb10", "50": "https://zenodo.org/record/21367800/thumb50", "100": "https://zenodo.org/record/21367800/thumb100", "250": "https://zenodo.org/record/21367800/thumb250", "750": "https://zenodo.org/record/21367800/thumb750", "1200": "https://zenodo.org/record/21367800/thumb1200"}, "latest_draft": "https://zenodo.org/api/deposit/depositions/21367800", "latest_draft_html": "https://zenodo.org/deposit/21367800", "publish": "https://zenodo.org/api/deposit/depositions/21367800/actions/publish", "edit": "https://zenodo.org/api/deposit/depositions/21367800/actions/edit", "discard": "https://zenodo.org/api/deposit/depositions/21367800/actions/discard", "newversion": "https://zenodo.org/api/deposit/depositions/21367800/actions/newversion"}, "record_id": 21367800, "owner": 1599128, "files": [{"id": "bb912243-aa31-4ee2-abc2-d280a1c972a3", "filename": "ab_two_body_harmonic_readout_c1_area_sweep_preliminary_summary_ja.pdf", "filesize": 4197354, "checksum": "516f2ddcccd35795cb76dcd20fcd419a", "links": {"self": "https://zenodo.org/api/deposit/depositions/21367800/files/bb912243-aa31-4ee2-abc2-d280a1c972a3", "download": "https://zenodo.org/api/records/21367800/draft/files/ab_two_body_harmonic_readout_c1_area_sweep_preliminary_summary_ja.pdf/content"}}, {"id": "74c6407c-a92b-4889-b44b-c1d8cee