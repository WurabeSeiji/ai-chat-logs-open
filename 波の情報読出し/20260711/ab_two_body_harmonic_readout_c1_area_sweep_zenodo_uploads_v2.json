    "conceptdoi": "10.5281/zenodo.21318696",
    "metadata": {
      "title": "Preliminary Summary of Harmonic Readout and c=1 Area Sweep in an AB Two-Body Closed Phase System",
      "publication_date": "2026-07-13",
      "description": "This release publishes a preliminary summary of six AB two-body closed phase system experiments. The experiments show that acceleration-like harmonic readout can be constructed from the label-free two-body relation f_AB without introducing external standard forces, individual forces f_A/f_B, or a background space. They also show that the AB two-body system alone lacks an independent gauge for deciding whether the acceleration-like readout follows proportional, inverse, or inverse-square dependence on position phase difference. Internal c=1 calibration and chi-tau area readout can be established, but native inverse-area scaling was not detected.",
      "access_right": "open",
      "creators": [
        {
          "name": "Kihara, Noriaki",
          "affiliation": "WF System Co., Ltd.",
          "orcid": "0009-0004-6753-4020"
        }
      ],
      "keywords": [
        "AB two-body closed phase system",
        "harmonic readout",
        "acceleration-like readout",
        "label-free relation",
        "c=1 internal calibration",
        "chi-tau area",
        "inverse-area diagnosis",
        "native readout",
        "wave information readout"
      ],
      "related_identifiers": [
        {
          "identifier": "10.5281/zenodo.21315735",
          "relation": "isSupplementTo",
          "resource_type": "publication-preprint",
          "scheme": "doi"
        },
        {
          "identifier": "10.5281/zenodo.21308049",
          "relation": "isSupplementTo",
          "resource_type": "publication-preprint",
          "scheme": "doi"
        }
      ],
      "version": "v2",
      "language": "eng",
      "license": "cc-by-4.0",
      "imprint_publisher": "Zenodo",
      "notes": "This paper does not claim a derivation of standard gravity or a native inverse-square law. Its scope is the AB two-body closed phase system: acceleration-like harmonic readout is constructible, while distance-exponent readout remains indeterminate without an independent gauge.",
      "upload_type": "publication",
      "publication_type": "preprint",
      "prereserve_doi": {
