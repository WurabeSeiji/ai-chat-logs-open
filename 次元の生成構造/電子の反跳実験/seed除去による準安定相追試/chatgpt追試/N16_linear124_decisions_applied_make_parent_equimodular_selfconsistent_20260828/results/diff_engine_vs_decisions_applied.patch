+            sys_lr.set_theta(np.angle(v))
+            progress(f"親構成(等モジュラー) 収束 restart={r+1} 残差={res:.2e} |v|={np.linalg.norm(v):.6f} |z|²相対幅={spread:.2e} 非零辺={int(np.sum(np.abs(v)>1e-8))}/{m} σ={sig[:4]}")
+            return v, res, sig
+    msg = "make_parent: 等モジュラー自己無撞着解が得られず（restarts=%d）: " % restarts + ", ".join(f"r{r}:{st}:{x:.2e}" for r, st, x in log)
+    progress(msg)
+    raise RuntimeError(msg)
