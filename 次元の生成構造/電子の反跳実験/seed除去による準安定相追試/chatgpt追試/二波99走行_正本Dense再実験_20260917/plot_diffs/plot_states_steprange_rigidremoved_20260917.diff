+def remove_rigid(Ztr_slice, z0_full, L, den, t_offset):
+    """区間スライス Ztr_slice（先頭が t=t_offset）に W(t)=exp(-tΔτK0)Z(t) を適用。
+
+    K0 は常に t=0 の状態 z0_full から計算する（区間先頭ではない）。"""
+    import math
+    A = adjacency(L)
+    K0 = K_of(z0_full, A)
+    H0 = (1j * K0).astype(np.complex128, copy=False)
+    w, V = np.linalg.eigh(H0)
+    dtau = np.float64(2.0 * math.pi / den)
+    W = np.empty_like(Ztr_slice)
+    for i in range(Ztr_slice.shape[0]):
+        t = t_offset + i
+        phase = np.exp(+1j * dtau * t * w)
+        W[i] = V @ (phase * (V.conj().T @ Ztr_slice[i]))
+    return W
+
